{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Last Keys",
  "version": "0.1.0",
  "identifier": "app.lastkeys.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Last Keys",
        "width": 1120,
        "height": 740,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Password manager with end-to-end encryption",
    "longDescription": "Last Keys keeps your passwords, notes, cards and identities in an end-to-end encrypted vault, works offline and synchronizes with a server you choose.",
    "copyright": "Copyright © 2026 Last Keys. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
