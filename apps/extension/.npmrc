# Supply-chain hardening (ADR-0010, ADR-0011): no install scripts, exact versions.
ignore-scripts=true
save-exact=true
fund=false
engine-strict=true
# npm's peer resolver crashes on vitest's optional peers (it resolves them to
# newer @vitest/* releases that require a newer vitest). Every peer we need is
# declared explicitly in package.json; `npm ls` checks them in CI.
legacy-peer-deps=true
