# Public domain name of this server. A DNS record must point to this machine
# and ports 80/443 must be reachable for Caddy to obtain a certificate.
# "localhost" works for a local trial (Caddy then uses its own internal CA,
# which clients do not trust by default).
LK_DOMAIN=localhost

# Set to false once your account(s) exist, to close registration.
LK_ALLOW_REGISTRATION=true

# Published ports (change if 80/443 are taken, e.g. on a NAS).
LK_HTTP_PORT=80
LK_HTTPS_PORT=443

# Server image (default: built locally from this repository).
# LK_SERVER_IMAGE=lastkeys/server:local
